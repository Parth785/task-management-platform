          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.collectionVariables.set(\"admin_token\", json.accessToken);\r",
                  "\r",
                  "if (json.refreshToken) {\r",
                  "    pm.collectionVariables.set(\"refresh_token\", json.refreshToken);\r",
